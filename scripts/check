#!/usr/bin/env bash
set -euo pipefail

cd "$(dirname "${BASH_SOURCE[0]}")/.."
cargo fmt --check
cargo clippy --locked --all-targets -- -D warnings
cargo test --locked
cargo build --locked --release
target/release/herdr-copy-mode | diff -u mods/copy-mode/transitions.js -
node --test scripts/word-end.test.mjs
